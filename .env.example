# Обязательные
BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=

# Кто видит /admin. Список Telegram ID через запятую.
# Узнать свой ID: команда /myid.
# Если не задать — работает список по умолчанию, зашитый в admin.py.
ADMIN_IDS=

# ── Хранилище ───────────────────────────────────────────────────────────────
# Обычно не нужно: на сервере база сама ложится на подключённый том,
# локально — в ~/.rututor/bot.db.
# RUTUTOR_DATA_DIR=
# RUTUTOR_DB_PATH=
# RUTUTOR_LEGACY_DB_PATH=

# ── Служебные уведомления ───────────────────────────────────────────────────
# Один чат для технических предупреждений (например, база на временном диске).
# Пусто — бот никому ничего не шлёт, всё только в логи.
# RUTUTOR_ALERT_CHAT_ID=

# ── Еженедельная копия базы ─────────────────────────────────────────────────
# Без RUTUTOR_BACKUP_CHAT_ID автокопия выключена.
# RUTUTOR_BACKUP_CHAT_ID=
# RUTUTOR_BACKUP_WEEKDAY=5     # 0 — понедельник … 5 — суббота
# RUTUTOR_BACKUP_HOUR=3
# RUTUTOR_BACKUP_TZ_OFFSET=5   # Узбекистан — UTC+5
